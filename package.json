{
	"name": "sketch-organise-symbols",
	"description": "Organise symbol masters based on their names",
	"version": "0.1.0",
	"engines": {
		"sketch": ">=2025.1"
	},
	"skpm": {
		"name": "sketch-organise-symbols",
		"manifest": "src/manifest.json",
		"main": "sketch-organise-symbols.sketchplugin",
		"assets": [
			"assets/**/*"
		],
		"sketch-assets-file": "sketch-assets/icons.sketch"
	},
	"scripts": {
		"build": "skpm-build",
		"watch": "skpm-build --watch",
		"start": "skpm-build --watch --run",
		"postinstall": "npm run build && skpm-link"
	},
	"devDependencies": {
		"@skpm/builder": "^0.9.5"
	},
	"dependencies": {
		"@lewishowles/helpers": "^0.18.0"
	}
}
